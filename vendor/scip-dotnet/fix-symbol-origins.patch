+            ["RoslynTargetsPath"] = tasks,
+            ["RoslynTasksAssembly"] = Path.Combine(tasks, "Microsoft.Build.Tasks.CodeAnalysis.dll"),
+            ["CSharpCoreTargetsPath"] = Path.Combine(tasks, "Microsoft.CSharp.Core.targets"),
+            ["VisualBasicCoreTargetsPath"] = Path.Combine(tasks, "Microsoft.VisualBasic.Core.targets"),
+        });
+    }
