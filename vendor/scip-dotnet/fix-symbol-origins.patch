+// Source ownership is independent of the SCIP package placeholder ". .".
+public sealed class ScipSymbolOrigins
+{
+    private readonly HashSet<ISymbol> _sourceAssemblies = new(SymbolEqualityComparer.Default);
+    private readonly Dictionary<ISymbol, (string Value, SymbolInformation Info)> _references = new(SymbolEqualityComparer.Default);
+    public void SourceAssembly(IAssemblySymbol assembly) => _sourceAssemblies.Add(assembly);
+
+    private bool IsSource(ISymbol symbol) => symbol.Locations.Any(l => l.IsInSource) ||
+        symbol.DeclaringSyntaxReferences.Length > 0 ||
+        symbol.ContainingAssembly != null && _sourceAssemblies.Contains(symbol.ContainingAssembly);
+
+    private IEnumerable<INamespaceSymbol> Constituents(INamespaceSymbol symbol) => symbol.ConstituentNamespaces;
+
+    public ScipSymbol NamespacePackage(INamespaceSymbol symbol, bool allowGlobal)
+    {
+        var parts = Constituents(symbol).ToList();
+        if (parts.Count == 0) throw new InvalidOperationException("namespace has no Roslyn constituents");
+        if (parts.Any(IsSource))
+        {
+            if (!allowGlobal) return ScipSymbol.IndexLocalPackage;
+            var assemblies = parts.Where(IsSource).Select(p => p.ContainingAssembly)
+                .Where(a => a != null).Cast<ISymbol>().Distinct(SymbolEqualityComparer.Default).ToList();
+            if (assemblies.Count == 1)
+            {
+                var assembly = (IAssemblySymbol)assemblies.Single();
+                return ScipSymbol.Package(assembly.Identity.Name, assembly.Identity.Version.ToString());
+            }
+            // A namespace genuinely shared by multiple source assemblies has no unique package.
+            return ScipSymbol.IndexLocalPackage;
+        }
+        if (!parts.All(p => p.ContainingAssembly != null && !_sourceAssemblies.Contains(p.ContainingAssembly)))
+            throw new InvalidOperationException("namespace origin is indeterminate");
+        if (symbol.ContainingAssembly != null)
+            return ScipSymbol.Package(symbol.ContainingAssembly.Identity.Name, symbol.ContainingAssembly.Identity.Version.ToString());
+        // Genuine metadata-only merged namespace, with no unique assembly owner.
+        return ScipSymbol.IndexLocalPackage;
+    }
+
+    public void Reference(ISymbol symbol, string value, SymbolInformation info)
+    {
+        if (value.Length == 0 || value.StartsWith("local ")) return;
+        _references.TryAdd(symbol.OriginalDefinition, (value, info));
+    }
+
+    private static IEnumerable<string> SourcePaths(ISymbol symbol)
+    {
+        return symbol.DeclaringSyntaxReferences.Select(s => s.SyntaxTree.FilePath)
+            .Concat(symbol.Locations.Where(l => l.IsInSource && l.SourceTree != null).Select(l => l.SourceTree!.FilePath))
+            .Distinct(StringComparer.Ordinal);
+    }
+
+    public void Complete(Scip.Index index, string root, ILogger logger)
+    {
+        var documents = index.Documents.ToDictionary(d => Path.GetFullPath(Path.Combine(root, d.RelativePath)), StringComparer.Ordinal);
+        var declared = index.Documents.SelectMany(d => d.Symbols).Select(s => s.Symbol).ToHashSet(StringComparer.Ordinal);
+        var external = new Dictionary<string, SymbolInformation>(StringComparer.Ordinal);
+        foreach (var (symbol, reference) in _references)
+        {
+            var constituents = symbol is INamespaceSymbol ns ? Constituents(ns).Cast<ISymbol>().ToList() : new List<ISymbol> { symbol };
+            bool source = constituents.Any(IsSource);
+            var paths = constituents.SelectMany(SourcePaths).Distinct(StringComparer.Ordinal).ToList();
+            logger.LogDebug("SCIP origin {Origin}: {Symbol}; declarations {Declarations}; assembly {Assembly}",
+                source ? "Source" : symbol.ContainingAssembly == null ? "ExternalUnknownPackage" : "ExternalPackage",
+                reference.Value, string.Join(",", paths.Select(p => Path.GetRelativePath(root, p))), symbol.ContainingAssembly?.Identity.ToString());
+            if (declared.Contains(reference.Value)) continue;
+            if (source)
+            {
+                // An implicit member is defined by its real containing declaration.
+                var owner = symbol is IFieldSymbol { AssociatedSymbol: IPropertySymbol property }
+                    ? property : symbol.ContainingSymbol;
+                var supportedImplicit = symbol.IsImplicitlyDeclared || symbol is IMethodSymbol { MethodKind: MethodKind.Constructor or MethodKind.StaticConstructor };
+                if (paths.Count == 0 && supportedImplicit && owner != null) paths.AddRange(SourcePaths(owner));
+                var candidates = paths.Where(documents.ContainsKey).Select(p => documents[p]).Distinct().ToList();
+                if (candidates.Count == 0) throw new InvalidOperationException($"source definition is excluded or has no document: {reference.Value}");
+                if (supportedImplicit && owner != null && _references.TryGetValue(owner.OriginalDefinition, out var declaring) && declared.Contains(declaring.Value))
+                    reference.Info.Relationships.Add(new Relationship { Symbol = declaring.Value, IsDefinition = true });
+                // Roslyn source information belongs to actual declaration documents. No reference becomes a definition occurrence.
+                foreach (var document in candidates) if (!document.Symbols.Any(s => s.Symbol == reference.Value)) document.Symbols.Add(reference.Info.Clone());
+                declared.Add(reference.Value);
+            }
+            else
+            {
+                if (constituents.Any(s => s.Locations.Any(l => l.IsInSource) || s.DeclaringSyntaxReferences.Length > 0) ||
+                    !constituents.All(s => s.ContainingAssembly != null && !_sourceAssemblies.Contains(s.ContainingAssembly)))
+                    throw new InvalidOperationException($"external symbol origin is indeterminate: {reference.Value}");
+                external.TryAdd(reference.Value, reference.Info);
+            }
+        }
+        foreach (var info in external.Values) if (!declared.Contains(info.Symbol)) index.ExternalSymbols.Add(info);
+    }
